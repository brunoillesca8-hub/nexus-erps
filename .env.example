# Turso Database Configuration
# Get these from https://turso.tech/ or `turso db show <db-name>` & `turso db tokens create <db-name>`
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# In local development without Turso cloud, a local file fallback can be used:
# TURSO_DATABASE_URL="file:local.db"
